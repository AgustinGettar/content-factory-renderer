{
  "preset_id": "LUMI_SHORT_PRODUCTION_PRESET_V1_1",
  "version": "1.1.1",
  "derived_from": "LUMI_SHORT_PRODUCTION_PRESET_V1",
  "status": "READY_NOT_GLOBALLY_ACTIVE",
  "global_activation": false,
  "scope": "staging_validation_only",
  "unchanged_layers": [
    "AV2_canonical_planning",
    "Lumi_character_lock",
    "world_prop_continuity",
    "Visual_QA_V1_2",
    "persistent_provider_claims",
    "restart_safety",
    "no_automatic_retries",
    "voice_profile_canonical",
    "music_SFX_policy",
    "freeze_prevention"
  ],
  "video_generation_readiness_gate": {
    "id": "VIDEO_GENERATION_READINESS_GATE_V2",
    "version": "2.1.0",
    "position": "before_provider_claim_and_before_any_Higgsfield_request",
    "required_blocks": [
      "CANONICAL_START_STATE",
      "EDUCATIONAL_INVARIANTS",
      "CHARACTER_INVARIANTS",
      "ALLOWED_MOTION",
      "FORBIDDEN_TRANSFORMATIONS",
      "CAMERA_CONTRACT",
      "END_STATE_CONTRACT",
      "NATURAL_REAL_TIME_PACING_CONTRACT"
    ],
    "failure_behavior": {
      "provider_call": false,
      "cost_usd": 0,
      "automatic_retry": false,
      "automatic_variant": false
    }
  },
  "higgsfield_prompt_compiler": {
    "id": "HIGGSFIELD_PROMPT_COMPILER_V2",
    "version": "2.1.0",
    "free_form_prompt": false,
    "block_order": [
      "A_START_FRAME_AUTHORITY",
      "B_CHARACTER_LOCK",
      "C_EDUCATIONAL_OBJECT_LOCK",
      "D_ALLOWED_ACTION",
      "E_SECONDARY_MICRO_MOTION",
      "F_FORBIDDEN_CHANGES",
      "G_CAMERA",
      "H_END_STATE"
    ],
    "limits": {
      "max_primary_character_actions": 1,
      "max_camera_moves": 1,
      "max_educational_focus_objects": "scene_plan_explicit_value"
    },
    "required_motion_language": [
      "natural real-time motion",
      "normal conversational gesture speed",
      "natural blink/head/hand timing",
      "no slow motion",
      "no dreamy slow movement",
      "no prolonged pose holds except an explicit pedagogical response window"
    ]
  },
  "scene_risk_classifier": {
    "classes": ["LOW", "PEDAGOGICAL_LOCKED", "HIGH_COMPLEXITY"],
    "pedagogical_locked_domains": ["counting", "shapes", "letters", "numbers", "object_identity"],
    "pedagogical_locked_defaults": {
      "stability_over_motion_complexity": true,
      "multi_shots": false,
      "audio": "off",
      "single_continuous_shot": true,
      "camera": "static_or_subtle_push_in_only",
      "motion": "conservative"
    },
    "high_complexity_requires_mitigation": true
  },
  "source_image_readiness": {
    "id": "VIDEO_SOURCE_READINESS_V1",
    "version": "1.0.0",
    "visual_beauty_alone_is_sufficient": false,
    "required": [
      "all_required_elements_present",
      "correct_object_counts",
      "clear_geometry",
      "no_ambiguous_overlaps",
      "Lumi_anatomy_clean",
      "pedagogical_objects_fully_visible",
      "sufficient_motion_spacing",
      "no_visual_ambiguity",
      "no_extraneous_educational_objects"
    ],
    "failure_behavior": "NO_KLING_CALL"
  },
  "shape_locks": {
    "circle": ["one_canonical_circle", "rigid_geometry", "no_duplicate", "no_oval_transformation", "no_disappearance", "no_morph"],
    "triangle": ["one_canonical_triangle", "exactly_3_visible_sides", "rigid_geometry", "no_fourth_side", "no_duplicate", "no_morph"],
    "square": ["one_canonical_square", "4_equal_visible_sides", "stable_proportions", "no_rectangle_or_trapezoid", "no_duplicate", "no_morph"]
  },
  "expected_value_gate": {
    "reject_before_provider_if": [
      "source_QA_confidence_insufficient",
      "HIGH_COMPLEXITY_without_mitigation",
      "required_invariant_missing",
      "prompt_compiler_field_missing",
      "educational_object_ambiguous"
    ],
    "rejection_cost_usd": 0
  },
  "end_frame_policy": {
    "modes": ["NONE", "SAME_STATE_LOCK", "EXPLICIT_END_FRAME"],
    "global_last_image_url_enabled": false,
    "default": "NONE",
    "activation_rule": "risk_high_and_measured_expected_value_positive",
    "new_end_frame_generation_authorized": false
  },
  "cfg_scale_policy": {
    "CFG_SCALE_TUNING_REQUIRED": true,
    "current_production_value_unchanged": true,
    "future_benchmark": {
      "provider_execution_authorized": false,
      "representative_scenes": 2,
      "measure": ["prompt_adherence", "natural_motion", "identity_stability"]
    }
  },
  "cost_aware_generation_policy": {
    "exactly_once_dispatch": true,
    "automatic_retries": 0,
    "automatic_variants": 0,
    "silent_resubmits": 0,
    "provider_claim_created_only_after_all_readiness_gates_pass": true
  },
  "character_text_exclusion": {
    "TEXT_OVER_LUMI": "FORBIDDEN",
    "id": "CHARACTER_TEXT_EXCLUSION_ZONE",
    "inputs": ["Lumi_bounding_box_or_safe_region", "critical_educational_object_bounding_boxes", "frame_safe_area", "candidate_text_regions"],
    "layout_priority": ["Lumi_completely_visible", "educational_object_visible", "text_inside_remaining_safe_area"],
    "no_safe_space_behavior": ["reduce_text", "reposition_text", "suppress_optional_text", "fail_required_text_layout"],
    "forbidden_fallback": "cover_Lumi",
    "caption_qa": {
      "TEXT_CHARACTER_OVERLAP": 0,
      "EDUCATIONAL_OBJECT_OVERLAP_WHEN_CRITICAL": 0,
      "SAFE_AREA": "PASS",
      "READABILITY": "PASS"
    }
  },
  "pedagogical_pause_overlay_policy": {
    "pause_is_timing_instruction_not_visual_content": true,
    "technical_labels_visible": false,
    "suppressed_tokens": ["PAUSA", "Pausa", "pause", "wait", "hold", "espera"],
    "narration_may_follow_canonical_script": true,
    "preferred_visual_during_pause": ["question", "answer_options_or_shapes", "no_additional_text"],
    "required_pause_seconds": 2.5,
    "qa": {"PEDAGOGICAL_PAUSE_TECHNICAL_LABEL_VISIBLE": false}
  },
  "editorial_master_readiness_gate": {
    "id": "EDITORIAL_MASTER_READINESS_GATE_V1",
    "version": "1.0.0",
    "position": "after_caption_and_overlay_layout_before_master",
    "PERCEIVED_PLAYBACK_SPEED": "NATURAL_1X",
    "duration_target_seconds": {"minimum": 43, "maximum": 47, "force_exact_duration": false},
    "do_not_solve_by": "uniform_master_speedup",
    "correct_at": ["scene_plan_timing", "dialogue_density", "Kling_motion_direction", "clip_selection", "transition_timing", "silence_duration", "editorial_holds", "selective_retiming"],
    "limits": {
      "max_unjustified_static_hold_seconds": 0.75,
      "max_unnecessary_silence_seconds": 0.25,
      "max_average_transition_seconds": 0.3,
      "clip_stretched_to_fill": false
    },
    "qa_fields": ["STATIC_HOLD_DURATION", "UNNECESSARY_SILENCE_DURATION", "AVERAGE_TRANSITION_DURATION", "MOTION_PACING", "PERCEIVED_SPEED"],
    "block_if": ["PERCEIVED_SPEED_SLOW_without_pedagogical_justification", "caption_QA_not_PASS", "clip_stretched_to_fill"]
  },
  "source_asset_salvage_gate": {
    "id": "SOURCE_ASSET_SALVAGE_GATE_V1",
    "version": "1.0.0",
    "status": "DESIGN_READY_NOT_RUNTIME_ACTIVE",
    "position": "after_automated_source_QA_before_any_new_image_provider_claim",
    "preserve_original_automated_QA": true,
    "human_override_automatic": false,
    "classifications": ["ACCEPT_WITH_HUMAN_WARNING", "DETERMINISTIC_COLOR_FIX", "DETERMINISTIC_OVERLAY_FIX", "DETERMINISTIC_COMPOSITE_FIX", "GENERATIVE_REPAIR_REQUIRED"],
    "last_resort": "GENERATIVE_REPAIR_REQUIRED",
    "blocker_scope": ["educational_semantic_failure", "narration_contradiction", "major_continuity_failure", "character_or_anatomy_failure", "video_readiness_failure"],
    "warning_scope": ["visual_preference_deviation_without_teaching_impact"]
  },
  "educational_graphics_layer": {
    "id": "EDUCATIONAL_GRAPHICS_LAYER_V1",
    "version": "1.0.0",
    "status": "DESIGN_READY_NOT_RUNTIME_ACTIVE",
    "pipeline": ["GENERATIVE_BACKGROUND_AND_LUMI", "SOURCE_READINESS", "EDUCATIONAL_GRAPHICS_LAYER_V1", "DETERMINISTIC_COMPOSITE", "FINAL_SOURCE_READINESS", "KLING"],
    "renderers": ["SVG", "local_vector_rasterizer", "deterministic_compositor"],
    "exact": ["geometry", "RGB_or_hex_color", "dimensions", "positioning"],
    "exclusion_zones": ["frame_safe_area", "character", "critical_educational_objects"],
    "TEXT_OVER_LUMI": "FORBIDDEN",
    "TEXT_CHARACTER_OVERLAP": 0
  },
  "recovery_manager": {
    "id": "LUMI_RECOVERY_INCIDENT_MANAGER_V1",
    "status": "BACKLOG_ONLY_NOT_IMPLEMENTED"
  }
}
