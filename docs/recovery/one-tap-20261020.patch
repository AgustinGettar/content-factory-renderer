+    &&typeof authorizationReference==='string'&&authorizationReference.length>0
+    &&Number.isFinite(Date.parse(createdAt)),'REPLACEMENT_REVISION_INPUT_REQUIRED');
+  const maximum=usd(maximumNewReservation),exposure=sumUsd([proposal.existing_episode_exposure_usd,maximum]);
+  requireThat(exposure<=proposal.budget_ceiling_usd,'REPLACEMENT_DOUBLE_EXPOSURE_BUDGET_BLOCKED');
+  const {proposal_digest,...old}=proposal;
+  const value={...old,version:proposal.version+1,previous_proposal_digest:proposal_digest,
+    revision_authorization_reference:authorizationReference,created_at:createdAt,
+    maximum_new_reservation:maximum,potential_episode_exposure_usd:exposure,
+    potential_duplicate_cost:{...proposal.potential_duplicate_cost,proposed_additional_reservation_usd:maximum,
+      combined_q42_or_action_exposure_usd:sumUsd([proposal.original_reserved_usd,maximum])}};
+  return {...value,proposal_digest:recoveryDigest(value)};
+}
