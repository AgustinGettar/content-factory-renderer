  "blocker_definition": [
    "educational_semantic_failure",
    "narration_contradiction",
    "major_continuity_failure",
    "character_or_anatomy_failure",
    "video_readiness_failure"
  ],
  "warning_definition": [
    "visual_preference_deviation_without_teaching_impact",
    "prompt_detail_deviation_without_narration_or_continuity_impact"
  ]
}
