    "CHARACTER_STATE": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "character_lock_id": {
          "type": "string",
          "minLength": 1
        },
        "character_lock_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "world_lock_id": {
          "type": "string",
          "minLength": 1
        },
        "world_lock_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "identity_preserved": {
          "const": true
        },
        "canonical_wings": {
          "const": 2
        },
        "wand_policy": {
          "type": "string",
          "minLength": 1
