                  "FULLY_VISIBLE",
                  "PARTIAL",
                  "HIDDEN"
                ]
              }
            },
            "required": [
              "id",
              "count",
              "color",
              "shape",
              "placement",
              "visibility"
            ],
            "additionalProperties": false
