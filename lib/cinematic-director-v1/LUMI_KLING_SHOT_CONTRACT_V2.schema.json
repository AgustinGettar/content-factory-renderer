          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "color": {
                "type": "string",
                "minLength": 1
              },
              "shape": {
                "type": "string",
                "minLength": 1
              },
              "placement": {
                "type": "string",
                "minLength": 1
