      "type": "string",
      "minLength": 1
    },
    "shot_type": {
      "type": "string",
      "enum": [
        "ESTABLISHING",
        "MEDIUM_TEACHING",
        "CLOSE_EMOTION",
        "EDUCATIONAL_OBJECT",
        "MAGIC_REWARD",
        "QUESTION_TO_VIEWER"
      ]
    },
    "START_STATE": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "object_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "color": {
                "type": "string",
                "minLength": 1
              },
              "shape": {
                "type": "string",
                "minLength": 1
              },
              "placement": {
                "type": "string",
                "minLength": 1
              },
              "visibility": {
                "type": "string",
